# ===============================
# 出力形式：dvi → pdf (dvipdfmx)
# ===============================
$pdf_mode = 3;

# ===============================
# コマンド定義
# ===============================
$platex = 'platex -interaction=nonstopmode -synctex=1 %O %S';
$bibtex = 'bibtex %B';
$dvipdf = 'dvipdfmx %O -o %D %S';

# ===============================
# BibTeX を有効化
# ===============================
$bibtex_use = 1;

# ===============================
# エラー・警告の扱い
# ===============================
$halt_on_error = 0;
$warnings_as_errors = 0;

# ===============================
# 再実行回数
# ===============================
$max_repeat = 5;

# ===============================
# 中間ファイルの拡張子
# ===============================
$clean_ext = 'aux bbl blg log dvi toc lof lot out nav snm synctex.gz';
