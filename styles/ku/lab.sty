%------------------------------------------------------------------------------
% 罫線を波線にする \clinesolid を定義
% 例題：
%   \begin{tabular}{|c|c|c|}\hline
%       曜日 & 開店時間 & 閉店時間 \\ \hline
%       金曜 & 10:00 & 17:00 \\ \clinesolid{1-3}
%       土曜 & 10:00 & 18:00 \\ \clinesolid{1-3}
%       日曜 & 10:00 & 20:00 \\ \hline
%   \end{tabular}
%------------------------------------------------------------------------------
\def\clinesolidpattern#1#2{%
    \ifdim#2<#1
        \errmessage{clinepatternの第１引数は第２引数以下です。}%
    \else
        \gdef\clinesolid@solid{#1}\gdef\clinesolid@period{#2}
    \fi
}

\clinesolidpattern{2pt}{4pt}%   4ptごとに2ptの線を引く

\newcount\@clasolid
\newcount\@clbsolid

\def\clinesolid#1{\@clinesolid[#1]}
\def\@clinesolid[#1-#2]{\noalign{\global\@clasolid#1\relax
\global\advance\@clasolid\m@ne
\ifnum\@clasolid>0\global\let\@gtempa\@clineasolid\else
  \global\let\@gtempa\@clinebsolid\fi
\global\@clbsolid#2\relax
\global\advance\@clbsolid-\@clasolid}\@gtempa
\noalign{\vskip-\arrayrulewidth}}

\def\@clineasolid{\multispan\@clasolid&\multispan\@clbsolid
    \unskip\cleaders\hbox to \clinesolid@period
    {\hss\rule{\clinesolid@solid}{\arrayrulewidth}\hss}\hfill\cr}

\def\@clinebsolid{\multispan\@clbsolid
    \unskip\cleaders\hbox to \clinesolid@period
    {\hss\rule{\clinesolid@solid}{\arrayrulewidth}\hss}\hfill\cr}

