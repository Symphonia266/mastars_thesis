% 上付き citation, supcite の定義
%------------------------------------------------------------------------------
%	\cite コマンドの出力を生成するマクロ
%		\supcite (上つき参照) の作成
%		\cite (通常参照) の作成
%	Ver.1.00
\def\@cite#1{$^{\mbox{\scriptsize{[#1]}}}$}
\def\@cite#1#2{[{#1\if@tempswa , #2\fi}]}
\def\cite{\@ifnextchar [{\@tempswatrue\@citex}{\@tempswafalse\@citex[]}}

\def\@supcite#1{$^{\mbox{\scriptsize{[#1]}}}$}
\def\supcite{\@ifnextchar [{\@tempswatrue\@supcitex}{\@tempswafalse\@supcitex[]}}
\def\@supcitex[#1]#2{\if@filesw\immediate\write\@auxout{\string\citation{#2}}\fi
  \def\@citea{}\@supcite{\@for\@citeb:=#2\do
    {\@citea\def\@citea{,\penalty\@m\ }\@ifundefined
       {b@\@citeb}{{\bf ?}\@warning
       {Citation `\@citeb' on page \thepage \space undefined}}%
\hbox{\csname b@\@citeb\endcsname}}}{#1}}

%------------------------------------------------------------------------------
% equation 環境で式番号を表示させない equation* 環境の定義
%   通常、デフォルトでは displaymath が式番号を表示させない環境だが
%   eqnarray と eqnarray* との対応をとるため displaymath を equation* として
%   定義した。
%
% 例
% \begin{equation*}
%   \dot x = Ax + Bu
% \end{equation*}
%
%------------------------------------------------------------------------------
% \newenvironment{equation*}{\begin{displaymath}}{\end{displaymath}\par}

