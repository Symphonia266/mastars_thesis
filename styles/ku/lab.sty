\def\sectionsize#1{\gdef\@sectionsize{#1}}
\def\subsectionsize#1{\gdef\@subsectionsize{#1}}
\def\subsubsectionsize#1{\gdef\@subsubsectionsize{#1}}
\def\paragraphsize#1{\gdef\@paragraphsize{#1}}
\def\subparagraphsize#1{\gdef\@subparagraphsize{#1}}

% section サイズの定義
\def\section@size{%
  \@ifundefined{@sectionsize}{\Large\bf}{\@sectionsize\bf}
}
\def\subsection@size{%
  \@ifundefined{@subsectionsize}{\large\bf}{\@subsectionsize\bf}
}
\def\subsubsection@size{%
  \@ifundefined{@subsubsectionsize}{\normalsize\bf}{\@subsubsectionsize\bf}
}
\def\paragraph@size{%
  \@ifundefined{@paragraphsize}{\normalsize\bf}{\@paragraphsize\bf}
}
\def\subparagraph@size{%
  \@ifundefined{@subparagraphsize}{\normalsize\bf}{\@subparagraphsize\bf}
}

% section 等の変更
\def\section{\@startsection {section}{1}{\z@}{3.5ex plus 1ex minus 
 .2ex}{2.3ex plus .2ex}{\section@size}}

\def\subsection{\@startsection{subsection}{2}{\z@}{3.25ex plus 1ex minus 
 .2ex}{1.5ex plus .2ex}{\subsection@size}}

\def\subsubsection{\@startsection{subsubsection}{3}{\z@}{3.25ex plus 
1ex minus .2ex}{1.5ex plus .2ex}{\subsubsection@size}}

\def\paragraph{\@startsection
 {paragraph}{4}{\z@}{3.25ex plus 1ex minus .2ex}{-1em}{\paragraph@size}}

\def\subparagraph{\@startsection
