%------------------------------------------------------------------------------
% 箇条書き環境 namelist の定義
%
% 例
% \begin{namelist}{beside, besidesxx}
%   \item[{\bf beside, besides}] Beside means along side of; besides means
%       in addition to.
%       They sat beside the brook all afternoon.
%       Besides, Tom doesn't want the job.
%   \item[{\bf could of}] Do not use for could have.
%   \item[{\bf data}] Data is the plural of datum. Data are gathered.
%       Say these data rather than this data.
% \end{namelist}
%
%------------------------------------------------------------------------------
% namelist environment (Nelson H. F. Beebe)
% form: \begin{namelist}{width}
\newcommand{\namelistlabel}[1]{\mbox{#1}\hfil}
\newenvironment{namelist}[1]{%
\begin{list}{}
  {\let\makelabel\namelistlabel
   \settowidth{\labelwidth}{#1}
   \setlength{\leftmargin}{1.1\labelwidth}}
 }{%
 \end{list}}

%------------------------------------------------------------------------------
% ２次形式の行列表示（行ベクトルを行列の上部に揃える）
%
% 例
% \begin{equation}
%   \pmatrix{x & y & z}
%   \topmatrix{a_1 & a_2 & a_3 \cr
%             a_4 & a_5 & a_6 \cr
%             a_7 & a_8 & a_9 \cr
%   }
%   \topmatrix{b \cr c \cr d}
% \end{equation}
%
% 変更点：オリジナルの \pmatrix では () ( \left(, \right) ) で定義されていた
%         のを [] ( \left[, \rhgt] ) に変更
% 
% \def\pmatrix#1{\left( \matrix{#1} \right)}    % オリジナル
%                    ~~~                 ~~
% \def\pmatrix#1{\left[ \matrix{#1} \right]}    % 変更後
%
%------------------------------------------------------------------------------
\def\pmatrix#1{\left[ \matrix{#1} \right]}
\newbox\matbox
\def\topmatrix#1{\setbox\matbox=\vtop{\normalbaselines\m@th % set the matrix in
  \ialign{\hfil$##$\hfil&&\quad\hfil$##$\hfil\crcr % a \vtop so the
  \mathstrut\crcr\noalign{\kern-\baselineskip} % first baseline
  #1\crcr\mathstrut\crcr\noalign{\kern-\baselineskip}}} % line up.
% get twice defference between baseline and centerline of inner matrix:
  \dimen255=\dp\matbox \advance\dimen255 by -\ht\matbox
% Center matrix and surround with parentheses:
  \setbox\matbox=\hbox{$\left[ \,\vcenter{\box\matbox}\,\right]$}
% Correct for difference between baseline and centerline of parentheses:
  \advance\dimen255 by -\dp\matbox \advance\dimen255 by \ht\matbox
% Lower centered matrix back to its prper baseline:
  \lower0.5\dimen255\box\matbox
}

%------------------------------------------------------------------------------
% キャプションの中に強制改行を入れる
%
% 例
% \begin{figure}[h]
%   \vspace{2cm}
%   \parcaption{This is a long caption \\ with line-break.}
% \end{figure}
%
%------------------------------------------------------------------------------
\newsavebox{\@parc@ption}
\def\parcaption#1{%
  \sbox{\@parc@ption}{\shortstack[l]{#1}}%
  \setbox\@tempboxa\hbox{\csname fnum@\@captype\endcsname}%
  \@tempdima\columnwidth \advance\@tempdima-\wd\@tempboxa
  \@tempdimb.8\@tempdima %<-- maximum length is set here
  \ifdim\wd\@parc@ption>\@tempdimb \@tempdima\@tempdimb
    \else\@tempdima\wd\@parc@ption\fi
    \sbox{\@tempboxa}{\parbox[t]{\@tempdima}{#1}}%
    \caption{\usebox{\@tempboxa}}}


