%------------------------------------------------------------------------------
% \list 環境の項目間の空きを調整
%
% \listisep{n}      一番外側のリスト項目間に \parsep に加えて挿入する垂直方向の
%                   スペース。
% \listiisep{n}     その内側のリスト項目間に \parsep に加えて挿入する垂直方向の
%                   スペース。
% \listiiisep{n}    その内側のリスト項目間に \parsep に加えて挿入する垂直方向の
%                   スペース。
%
% デフォルトでは、\listisep, \listiisep, \listiiisep はすべて 0pt に設定
%
% 例
% \begin{enumerate}
%   \listisep{1mm}
%   \listiisep{1mm}
%   \listiiisep{1mm}
%   \item ここは一番外側のリストです。
%   \item ここは一番外側のリストです。
%   \begin{enumerate}
%     \item その内側のリストです。
%     \begin{enumerate}
%       \item その内側のリストです。
%       \item その内側のリストです。
%     \end{enumerate}
%     \item その内側のリストです。
%   \end{enumerate}
%   \item ここは一番外側のリストです。
% \end{enumerate}
%
%------------------------------------------------------------------------------
\def\listsep#1{\gdef\@listsep{#1}}
%\def\listiisep#1{\gdef\@listiisep{#1}}
%\def\listiiisep#1{\gdef\@listiiisep{#1}}

\def\Listi@sep{%
  \@ifundefined{@listsep}{0pt plus 2pt}{\@listsep}
}

\def\Listii@sep{%
  \@ifundefined{@listsep}{0pt plus 2pt}{\@listsep}
}

\def\Listiii@sep{%
  \@ifundefined{@listsep}{0pt plus 2pt}{\@listsep}
}

\def\@listI{% １番外側のリストのパラメータの初期値
  \leftmargin\leftmargini % 左余白
  \parsep=\z@  % 項目間の段落の空き
  \topsep 6pt plus 2pt minus 2pt  % リスト上下の空き
  \itemsep=\Listi@sep\relax % 項目間の空き
}
\let\@listi\@listI
\@listi 
%
\def\@listii{% その内側のリストのパラメータ
  \leftmargin\leftmarginii
   \labelwidth\leftmarginii
   \advance\labelwidth-\labelsep
   \topsep 3pt plus 2pt minus 1pt
   \parsep=\z@ %
   \itemsep=\Listii@sep\relax
}
%
\def\@listiii{% その内側のリストのパラメータ
  \leftmargin\leftmarginiii
   \labelwidth\leftmarginiii
   \advance\labelwidth-\labelsep
   \topsep 2pt plus 1pt minus 1pt 
%   \parsep \z@ \partopsep 1pt plus 0pt minus 1pt
   \parsep \z@ \partopsep \z@
   \itemsep=\Listiii@sep\relax
}
%
\def\@listiv{% その内側のリストのパラメータ
  \leftmargin\leftmarginiv
  \labelwidth\leftmarginiv
  \advance\labelwidth-\labelsep
}
%
\def\@listv{% その内側のリストのパラメータ
  \leftmargin\leftmarginv
  \labelwidth\leftmarginv
  \advance\labelwidth-\labelsep
}
%
\def\@listvi{% 最も内側のリストのパラメータ
  \leftmargin\leftmarginvi
  \labelwidth\leftmarginvi
  \advance\labelwidth-\labelsep
}

